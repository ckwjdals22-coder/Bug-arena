# ─────────────────────────────────────────────────────────────
# 남는자리 환경 변수 — 이 파일을 .env 로 복사해 값을 채우세요.
# [필수] 표시가 없는 값은 비워 두면 해당 기능이 "미연동" 상태로 동작합니다.
# ─────────────────────────────────────────────────────────────

# [필수] PostgreSQL 연결 주소
DATABASE_URL="postgresql://namneun:namneun@localhost:5432/namneun?schema=public"

# [필수] 서비스 공개 주소(끝에 / 없이). 링크 생성·Origin 검사·보안 쿠키 판단에 사용
APP_URL="http://localhost:3000"

# [운영 필수] 계좌번호·2단계 인증 비밀키 암호화 키. 생성: openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# [운영 필수] 주기 작업 엔드포인트(/api/cron/tick) 보호용 비밀값. 생성: openssl rand -hex 32
CRON_SECRET=""

# 서버 한 대로 운영할 때 1 로 두면 프로세스 안에서 1분마다 주기 작업을 실행합니다.
# (Vercel 등 서버리스에서는 비우고 외부 스케줄러로 /api/cron/tick 을 호출하세요.)
ENABLE_INTERNAL_CRON=""

# ── 결제 ─────────────────────────────────────────────────────
# mock: 테스트 결제(실제 청구 없음) / toss: 토스페이먼츠
PAYMENT_PROVIDER="mock"
TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

# ── 문자·알림톡 ──────────────────────────────────────────────
# none: 발송하지 않고 기록만 남김 / solapi: 솔라피
SMS_PROVIDER="none"
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
# 사전 등록한 발신번호(숫자만)
SOLAPI_SENDER=""
SOLAPI_KAKAO_PFID=""

# ── 이메일(비밀번호 재설정 등) ───────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="남는자리 <no-reply@example.com>"

# ── 이미지 저장 ──────────────────────────────────────────────
# local: 서버 디스크(./uploads) / s3: S3 호환 스토리지(AWS S3, Cloudflare R2 등)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# 1 이면 시연 배포로 봅니다: 로그인 화면에 데모 계정 빠른 로그인 버튼을 보여 주고,
# 운영 모드(NODE_ENV=production)에서도 테스트 결제(PAYMENT_PROVIDER=mock)를 허용합니다.
# 실제 운영에서는 반드시 비우세요.
DEMO_MODE=""

# 앱 앞단의 신뢰할 수 있는 리버스 프록시 수(기본 1). 요청 제한에 쓰는 클라이언트 IP 판정에 사용합니다.
TRUSTED_PROXY_HOPS="1"

# 카카오 로그인(선택). 카카오 디벨로퍼스에서 REST API 키를 발급받고
# Redirect URI 로 {APP_URL}/api/auth/kakao/callback 을 등록하세요. 비워 두면 버튼이 보이지 않습니다.
# 동의항목에서 닉네임(profile_nickname)과 카카오계정 이메일(account_email)을 켜야 합니다.
# 이메일이 인증된 카카오 계정만 가입·연결할 수 있습니다. Client Secret 을 켰다면 KAKAO_CLIENT_SECRET 도 채우세요.
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# 국세청 사업자등록 상태조회(선택). 공공데이터포털(data.go.kr)의 "국세청_사업자등록정보 진위확인 및 상태조회 서비스"
# 일반 인증키(Decoding)를 넣으세요. 비워 두면 입점 심사에서 사업자등록번호의 형식(검증 숫자)만 확인합니다.
NTS_SERVICE_KEY=""

# 최초 실행 시 만드는 운영자 계정(시드). 비밀번호를 비우면 임의 값을 만들어 한 번 출력합니다.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# ── 운영자(회사) 정보 — 푸터·약관·개인정보처리방침에 표시됩니다 ─────────
# 비워 두면 화면에 "[운영자 정보 입력 필요: …]" 로 표시되고 운영자 콘솔 "연동 상태"에 미입력으로 나옵니다.
OPERATOR_COMPANY_NAME=""
OPERATOR_REPRESENTATIVE=""
OPERATOR_BUSINESS_REG_NO=""
# 통신판매업 신고번호
OPERATOR_MAIL_ORDER_REG_NO=""
OPERATOR_ADDRESS=""
OPERATOR_PHONE=""
OPERATOR_EMAIL=""
# 개인정보 보호책임자(이름·연락처)
OPERATOR_PRIVACY_OFFICER=""
# 호스팅 서비스 제공자(예: Amazon Web Services)
OPERATOR_HOSTING_PROVIDER=""
# 개인정보 처리 위탁사의 처리 국가·연락처(국외 이전 고지용). 해당 연동을 쓸 때만 채웁니다.
OPERATOR_HOSTING_COUNTRY=""
OPERATOR_HOSTING_CONTACT=""
OPERATOR_STORAGE_COUNTRY=""
OPERATOR_STORAGE_CONTACT=""
OPERATOR_EMAIL_SENDER_COUNTRY=""
OPERATOR_EMAIL_SENDER_CONTACT=""
